{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile for registered customers and admins",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "maxLength": 256
        },
        "displayName": {
          "type": "string",
          "maxLength": 100
        },
        "photoURL": {
          "type": "string",
          "maxLength": 1000
        },
        "phone": {
          "type": "string",
          "maxLength": 20
        },
        "address": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": ["uid", "email"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Collection of user profiles where each user can read and manage only their own document"
    }
  }
}
